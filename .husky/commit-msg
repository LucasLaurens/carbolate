# Lucas Laurens is the only author: drop every co-author and "Generated with" line.
grep -v -i -E '^[[:space:]]*(co-authored-by:|.*generated (with|by) )' "$1" > "$1.tmp"
mv "$1.tmp" "$1"

# File names CLAUDE.md and .claude/ are paths, not attribution; any other mention is refused.
if sed -e '/^#/d' -e 's/CLAUDE\.md//g' -e 's#\.claude/##g' "$1" | grep -q -i -E 'claude|anthropic|LucasLaurensHeyteam'; then
  echo "Refused: commit message mentions Claude, Anthropic or LucasLaurensHeyteam." >&2
  exit 1
fi
