{
  "type": "module",
  "name": "carbolate",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs chrome",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "package:chrome": "npm run build:chrome && cd dist && zip -qrFS ../carbolate-chrome.zip .",
    "package:firefox": "npm run build:firefox && cd dist && zip -qrFS ../carbolate-firefox.zip .",
    "package:sources": "git archive --format=zip -o carbolate-sources.zip HEAD",
    "package:all": "npm run package:chrome && npm run package:firefox && npm run package:sources",
    "store-assets": "bash scripts/render-store-assets.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/chrome": "^0.0.273",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.1.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "chart.js": "^4.5.1"
  },
  "overrides": {
    "brace-expansion": "^2.1.7"
  }
}
